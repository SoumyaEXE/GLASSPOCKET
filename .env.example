# GLASSPOCKET bridge environment. Build Spec Section 04B.
#
# Copy to bridge/.env and fill in. COMMIT THIS FILE WITH EMPTY VALUES ONLY.
# The Streamlit application needs none of these: it runs inside Snowflake
# and obtains its session with get_active_session(). If any Snowflake
# credential appears in the app/ directory, that is a defect.

# --- Snowflake -------------------------------------------------------------
# Shape is orgname-accountname, from the Snowsight account details panel.
# This is the single most commonly mistyped value in the whole build.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=

# Optional and preferred. Multi-factor may be enforced on the trial.
# Generate with openssl, register the public key with
#   ALTER USER <user> SET RSA_PUBLIC_KEY='...';
SNOWFLAKE_PRIVATE_KEY_PATH=

# The bridge writes to the ORACLE schema and needs write privileges.
# Do not reuse GP_ANALYST here; that role exists to be constrained.
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=GP_WH
SNOWFLAKE_DATABASE=GLASSPOCKET
SNOWFLAKE_SCHEMA=ORACLE

# --- Solana ----------------------------------------------------------------
# Must be DAS-enabled. The default public devnet endpoint does not serve
# the Digital Asset Standard API and reads will fail. Use Helius devnet.
SOLANA_RPC_URL=
HELIUS_API_KEY=
PARSE_TRANSACTION=
PARSE_TRANSACTION_HISTORY=

# Generate locally with the Solana CLI. This wallet is the tree authority
# and pays for mints. Fund it from a devnet faucet on Friday, not Saturday.
SOLANA_KEYPAIR_PATH=./keys/authority.json

# Written once by `npm run tree`, then pasted back here. Tree parameters are
# immutable after creation, so record these carefully.
MERKLE_TREE_ADDRESS=
COLLECTION_MINT=

# Optional. Defaults to the authority wallet.
TREASURY_ADDRESS=

# --- Receipts --------------------------------------------------------------
# Generate locally, once, alongside the tree. Used to hash organisation
# identifiers before they go on chain, so the ledger carries a claim rather
# than a directly reversible identifier. Set it as a Snowflake session
# variable when populating the queue in sql/13_oracle_queue.sql.
RECEIPT_SALT=

# Tuning values, not secrets.
MINT_BATCH_SIZE=50
MINT_POLL_MS=4000
