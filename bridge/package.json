{
  "name": "glasspocket-bridge",
  "version": "1.0.0",
  "private": true,
  "description": "Polls the GLASSPOCKET mint queue in Snowflake, mints one compressed NFT receipt per verified disbursement on Solana devnet, and writes the result back. The signing key never touches the warehouse.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "tree": "tsx src/tree.ts",
    "start": "tsx src/index.ts",
    "once": "tsx src/index.ts --once",
    "balance": "tsx src/tree.ts --balance",
    "typecheck": "tsc --noEmit",
    "mine": "devnet-pow mine -d 3 --reward 0.02 --no-infer -t 1000000000 -u dev -k ../authority.json",
    "fund": "node fund_check.mjs"
  },
  "dependencies": {
    "@metaplex-foundation/mpl-bubblegum": "^4.2.1",
    "@metaplex-foundation/mpl-token-metadata": "^3.2.1",
    "@metaplex-foundation/umi": "^0.9.2",
    "@metaplex-foundation/umi-bundle-defaults": "^0.9.2",
    "@metaplex-foundation/digital-asset-standard-api": "^1.0.4",
    "@solana/web3.js": "^1.95.3",
    "dotenv": "^16.4.5",
    "snowflake-sdk": "^1.14.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
